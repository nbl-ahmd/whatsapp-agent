# ---------------------------------------------------------------------------
# Backend API environment - deployed to Render.
# Copy to server/.env (or keep these in the repo-root .env for local dev).
# Never commit real secrets.
# ---------------------------------------------------------------------------

# Server binding. Render supplies PORT; do not hardcode it in production.
PORT=4000
HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=info

# Browser origin allowed to call this API (comma separated for multiple).
FRONTEND_URL=http://localhost:3000

# Database (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/whatsapp_agent?schema=public

# Secret used to encrypt credentials at rest. Generate with: openssl rand -hex 32
ENCRYPTION_KEY=

# Redis / background jobs (optional until workers are enabled)
REDIS_URL=redis://localhost:6379

# Meta WhatsApp Cloud API
WHATSAPP_GRAPH_API_BASE_URL=https://graph.facebook.com
WHATSAPP_GRAPH_API_VERSION=v21.0
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=

# Shared key protecting POST /api/whatsapp/messages. Required in production.
WHATSAPP_TEST_API_KEY=

# AI provider (OpenAI-compatible)
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
