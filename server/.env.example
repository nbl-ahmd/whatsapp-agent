# ---------------------------------------------------------------------------
# Backend API environment - deployed to Render.
# Copy to server/.env (or keep these in the repo-root .env for local dev).
# Never commit real secrets.
# ---------------------------------------------------------------------------

# Server binding. Render supplies PORT; do not hardcode it in production.
PORT=4000
HOST=0.0.0.0
LOG_LEVEL=info
NODE_ENV=development

# Optional endpoint for unhandled server errors (JSON POST, best-effort).
ERROR_WEBHOOK_URL=

# Browser origin allowed to call this API (comma separated for multiple).
# A trailing slash is ignored. Preview patterns like https://*.vercel.app are
# allowed; a bare * is not.
FRONTEND_URL=http://localhost:3000

# Database (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/whatsapp_agent?schema=public

# Secret used to encrypt credentials at rest. Generate with: openssl rand -hex 32
ENCRYPTION_KEY=

# Signing secret for session tokens. Falls back to ENCRYPTION_KEY when unset;
# set it explicitly in production. Generate with: openssl rand -hex 32
AUTH_SECRET=

# Session lifetime in hours (default 168 = 7 days)
AUTH_TOKEN_TTL_HOURS=168

# Redis / background jobs (optional; the default queue driver is in-process)
REDIS_URL=redis://localhost:6379

# Meta WhatsApp Cloud API.
#
# These can also be saved per organization in Settings → API credentials
# (encrypted in Postgres, managed from the UI). Environment values are the
# fallback. Phone numbers in "simulator" provider mode need no credentials.
WHATSAPP_GRAPH_API_BASE_URL=https://graph.facebook.com
WHATSAPP_GRAPH_API_VERSION=v21.0
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=

# Shared key protecting POST /api/whatsapp/messages for server-to-server calls.
# Required in production; signed-in operators do not need it.
WHATSAPP_TEST_API_KEY=

# AI provider. "openai" = any OpenAI-compatible /chat/completions endpoint.
# "mock" = deterministic local replies, so the AI loop runs without a key.
# When AI_PROVIDER is unset: "openai" if AI_API_KEY is set, otherwise "mock".
# These can also be saved in Settings → API credentials (env is the fallback).
AI_PROVIDER=
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# ---------------------------------------------------------------------------
# Rate limits (fixed window, per API process; counters reset on deploy)
# ---------------------------------------------------------------------------

# Login/register attempts per IP (default 20 per 15 minutes)
AUTH_RATE_LIMIT_MAX=20
AUTH_RATE_LIMIT_WINDOW_MS=900000

# Meta webhook deliveries per IP (default 600 per minute; keep generous)
WEBHOOK_RATE_LIMIT_MAX=600
WEBHOOK_RATE_LIMIT_WINDOW_MS=60000

# Outbound messages per organization (default 60 per minute)
MESSAGE_RATE_LIMIT_MAX=60
MESSAGE_RATE_LIMIT_WINDOW_MS=60000
